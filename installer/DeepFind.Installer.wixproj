<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>DeepFind-Setup-x64</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>$(DefineConstants);AppPublishDir=$(MSBuildProjectDirectory)/../src/DeepFind.App/bin/Release/net10.0-windows/win-x64/publish</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
    <PackageReference Include="WixToolset.Util.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
