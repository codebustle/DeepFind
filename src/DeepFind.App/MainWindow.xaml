<Window x:Class="DeepFind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeepFind.App"
        Title="DeepFind" Width="970" Height="690" MinWidth="440" MinHeight="410"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Background" Value="{DynamicResource ControlSurface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{DynamicResource Ink}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlSurface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlSurface}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource FocusEdge}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource FocusEdge}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FilterButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Chip" CornerRadius="16" Padding="13,6" BorderThickness="1"
                                Background="Transparent" BorderBrush="Transparent">
                            <ContentPresenter RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlSurface}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource ControlSurface}" />
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource Line}" />
                                <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource FocusEdge}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="26,22,26,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border x:Name="SearchFrame" Background="{DynamicResource ControlSurface}" BorderThickness="1" CornerRadius="26">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                    <Style.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource FocusEdge}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <DockPanel Margin="16,5,5,5">
                <Button DockPanel.Dock="Right" Content="Search" Click="OnSearch" Style="{StaticResource ToolButton}"
                        Margin="5,0,0,0" ToolTip="Run search (Enter)"
                        AutomationProperties.Name="Run search" />
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                           VerticalAlignment="Center" Foreground="{DynamicResource Secondary}" Margin="0,0,11,0" />
                <Grid>
                    <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"
                             Padding="0,8" FontSize="17" Background="Transparent" BorderThickness="0"
                             Foreground="{DynamicResource Ink}" CaretBrush="{DynamicResource Ink}"
                             VerticalContentAlignment="Center" AutomationProperties.Name="Search files"
                             ToolTip="Search file names, paths and document text" />
                    <TextBlock Text="Search files" Foreground="{DynamicResource Secondary}" FontSize="17"
                               VerticalAlignment="Center" IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DockPanel>
        </Border>
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}" Padding="0,13,0,8">
            <WrapPanel>
                <RadioButton x:Name="AllFilter" Content="All files" GroupName="Types" Tag="All" IsChecked="True"
                             Checked="OnFilter" Style="{StaticResource FilterButton}" />
                <RadioButton Content="Documents" GroupName="Types" Tag="Documents" Checked="OnFilter" Style="{StaticResource FilterButton}" />
                <RadioButton Content="PDF" GroupName="Types" Tag="Pdf" Checked="OnFilter" Style="{StaticResource FilterButton}" />
                <RadioButton Content="Excel" GroupName="Types" Tag="Excel" Checked="OnFilter" Style="{StaticResource FilterButton}" />
                <ComboBox x:Name="SortBox" MinWidth="119" Margin="10,0,0,4" VerticalContentAlignment="Center"
                          ItemsSource="{Binding SortOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedItem="{Binding Sort}" AutomationProperties.Name="Sort results" />
            </WrapPanel>
        </Border>
        <TextBlock Grid.Row="2" Text="{Binding ResultCount}" HorizontalAlignment="Right" Margin="4,9,4,5"
                   Foreground="{DynamicResource Secondary}" AutomationProperties.LiveSetting="Polite" />
        <Grid Grid.Row="3">
            <TextBlock Text="{Binding SearchMessage}" TextWrapping="Wrap" HorizontalAlignment="Center"
                       VerticalAlignment="Center" Foreground="{DynamicResource Secondary}" Margin="20"
                       AutomationProperties.LiveSetting="Polite" />
            <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="OnResultDoubleClick" AutomationProperties.Name="Search results">
                <ListBox.Style>
                    <Style TargetType="ListBox">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="_Preview" InputGestureText="Ctrl+P" Click="OnPreview" />
                        <Separator />
                        <MenuItem Header="_Open file" InputGestureText="Enter" Click="OnOpenFile" />
                        <MenuItem Header="Show in _Explorer" Click="OnReveal" />
                        <MenuItem Header="_Copy path" InputGestureText="Ctrl+C" Click="OnCopyPath" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ResultRow}">
                        <Border Padding="9,13,9,13" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource ControlSurface}" CornerRadius="8" Width="38" Height="38"
                                        Margin="0,0,13,0" VerticalAlignment="Top">
                                    <TextBlock Text="&#xE8A5;" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" local:HighlightText.Value="{Binding Name}"
                                               local:HighlightText.Terms="{Binding Hit.Highlights}" />
                                    <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"
                                               Foreground="{DynamicResource Secondary}" Margin="0,3,0,0" />
                                    <TextBlock Foreground="{DynamicResource Secondary}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               local:HighlightText.Value="{Binding Hit.Snippet}" local:HighlightText.Prefix="{Binding Location}"
                                               local:HighlightText.Terms="{Binding Hit.Highlights}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <DockPanel Grid.Row="4" Margin="0,10,0,0" LastChildFill="True">
            <Button DockPanel.Dock="Right" Content="Index settings" Click="OnSettings" Style="{StaticResource ToolButton}" Margin="10,0,0,0" />
            <TextBlock Text="{Binding IndexMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Foreground="{DynamicResource Secondary}" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>
    </Grid>
</Window>
