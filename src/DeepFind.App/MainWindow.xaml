<Window x:Class="DeepFind.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DeepFind.App"
        Title="DeepFind" Width="970" Height="690" MinWidth="440" MinHeight="410"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}"
        Loaded="OnLoaded" Closing="OnClosing" PreviewKeyDown="OnKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="VisibleWhenTrue" />
        <Style x:Key="ResultItem" TargetType="ListBoxItem" BasedOn="{StaticResource SoftListItem}">
            <Setter Property="Padding" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent"
                                BorderThickness="1" CornerRadius="8">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlSurface}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource ControlSurface}" />
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource FocusEdge}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource FocusEdge}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Margin="24,12,24,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <!-- Live search uses the entire width; Enter still refreshes. -->
        <Grid>
            <Border x:Name="SearchFrame" Background="{DynamicResource ControlSurface}" BorderThickness="1" CornerRadius="8"
                    MinHeight="36">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                        <Style.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource FocusEdge}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Grid Margin="11,3,3,3">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center"
                               Foreground="{DynamicResource Ink}" />
                    <Grid Grid.Column="1">
                        <TextBox x:Name="SearchBox" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" MaxLength="512"
                                 Style="{StaticResource SearchTextBox}" AutomationProperties.Name="Search files"
                                 AutomationProperties.AutomationId="SearchBox" ToolTip="Search file names, paths and document text" />
                        <TextBlock Text="Search files" Foreground="{DynamicResource Secondary}" FontSize="15"
                                   VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <Button Grid.Column="2" x:Name="ClearQueryButton" Click="OnClearSearch" ToolTip="Clear search"
                            AutomationProperties.Name="Clear search" AutomationProperties.AutomationId="ClearQueryButton">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <Path Data="M 4,4 L 12,12 M 4,12 L 12,4" Stroke="{DynamicResource Ink}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="None" />
                    </Button>
                </Grid>
            </Border>
        </Grid>
        <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}" Padding="0,10,0,4">
            <WrapPanel>
                <RadioButton x:Name="AllFilter" Content="All files" GroupName="Types" Tag="All" IsChecked="True"
                             Checked="OnFilter" Style="{StaticResource FilterButton}" MinWidth="78" />
                <RadioButton Content="Documents" GroupName="Types" Tag="Documents" Checked="OnFilter" Style="{StaticResource FilterButton}" MinWidth="94" />
                <RadioButton Content="PDF" GroupName="Types" Tag="Pdf" Checked="OnFilter" Style="{StaticResource FilterButton}" MinWidth="48" />
                <RadioButton Content="Excel" GroupName="Types" Tag="Excel" Checked="OnFilter" Style="{StaticResource FilterButton}" MinWidth="57" />
                <ComboBox x:Name="SortBox" MinWidth="119" Margin="8,0,0,4" VerticalAlignment="Center"
                          Style="{StaticResource SoftComboBox}" ItemsSource="{Binding SortOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                          SelectedValuePath="Value" DisplayMemberPath="Label" SelectedValue="{Binding Sort, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          AutomationProperties.Name="Sort results" AutomationProperties.AutomationId="SortBox" />
                <Button Content="View ▾" Click="OnView" Style="{StaticResource SoftButton}" Margin="4,0,0,4"
                        AutomationProperties.Name="Result view options" AutomationProperties.AutomationId="ViewOptions">
                    <Button.ContextMenu>
                        <ContextMenu Style="{StaticResource SoftContextMenu}" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Style="{StaticResource SoftMenuItem}" Header="File path" IsCheckable="True" IsChecked="{Binding ShowPath, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Style="{StaticResource SoftMenuItem}" Header="Match location" IsCheckable="True" IsChecked="{Binding ShowLocation, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Style="{StaticResource SoftMenuItem}" Header="Content excerpt" IsCheckable="True" IsChecked="{Binding ShowExcerpt, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <MenuItem Style="{StaticResource SoftMenuItem}" Header="Modified date" IsCheckable="True" IsChecked="{Binding ShowModified, Mode=TwoWay}" StaysOpenOnClick="True" />
                            <Separator />
                            <MenuItem Style="{StaticResource SoftMenuItem}" Header="Restore defaults" Click="OnRestoreView" />
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </WrapPanel>
        </Border>
        <WrapPanel Grid.Row="2" Margin="0,5,0,7">
            <TextBlock Text="{Binding ResultCount}" AutomationProperties.AutomationId="ResultCount" Margin="0,0,12,4" VerticalAlignment="Center"
                       FontSize="12" Foreground="{DynamicResource Secondary}" AutomationProperties.LiveSetting="Polite" />
            <Button Content="|‹" Click="OnFirstPage" IsEnabled="{Binding CanPrevious}" Style="{StaticResource SoftButton}"
                    Margin="0,0,4,4" AutomationProperties.Name="First page" AutomationProperties.AutomationId="FirstPage" />
            <Button Content="‹" Click="OnPreviousPage" IsEnabled="{Binding CanPrevious}" Style="{StaticResource SoftButton}"
                    Margin="0,0,4,4" AutomationProperties.Name="Previous page" AutomationProperties.AutomationId="PreviousPage" />
            <TextBlock Text="{Binding PageLabel}" AutomationProperties.AutomationId="PageLabel" VerticalAlignment="Center" Margin="2,0,6,4" AutomationProperties.LiveSetting="Polite" />
            <Button Content="›" Click="OnNextPage" IsEnabled="{Binding CanNext}" Style="{StaticResource SoftButton}"
                    Margin="0,0,4,4" AutomationProperties.Name="Next page" AutomationProperties.AutomationId="NextPage" />
            <Button Content="›|" Click="OnLastPage" IsEnabled="{Binding CanNext}" Style="{StaticResource SoftButton}"
                    Margin="0,0,10,4" AutomationProperties.Name="Last page" AutomationProperties.AutomationId="LastPage" />
            <TextBlock Text="Per page" VerticalAlignment="Center" Margin="0,0,6,4" FontSize="12" />
            <ComboBox ItemsSource="{Binding PageSizes, RelativeSource={RelativeSource AncestorType=Window}}"
                      SelectedItem="{Binding PageSize}" Style="{StaticResource SoftComboBox}" MinWidth="76"
                      Margin="0,0,0,4" AutomationProperties.Name="Results per page" AutomationProperties.AutomationId="PageSize" />
        </WrapPanel>
        <Grid Grid.Row="3">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <TextBlock Text="{Binding SearchMessage}" TextWrapping="Wrap" TextAlignment="Center"
                           AutomationProperties.LiveSetting="Polite">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFolders}" Value="False">
                                    <Setter Property="FontSize" Value="15" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <StackPanel Margin="0,8,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasFolders}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="DeepFind indexes the local folders you choose." TextWrapping="Wrap" FontSize="13"
                               TextAlignment="Center" Foreground="{DynamicResource Secondary}" />
                    <Button Content="Add folder" Click="OnSettings" Style="{StaticResource PrimaryButton}" MinWidth="138"
                            HorizontalAlignment="Center" Margin="0,18,0,0" AutomationProperties.Name="Add folder" />
                </StackPanel>
                <Button Content="Clear search" Click="OnClearSearch" HorizontalAlignment="Center" Margin="0,18,0,0" MinWidth="120">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource SoftButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SearchMessage}" Value="No matching files.">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <ListBox x:Name="ResultsList" ItemsSource="{Binding Results}" Background="Transparent" BorderThickness="0" Padding="0" ItemContainerStyle="{StaticResource ResultItem}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                     MouseDoubleClick="OnResultDoubleClick" PreviewMouseRightButtonDown="OnResultRightClick" AutomationProperties.Name="Search results" AutomationProperties.AutomationId="ResultsList">
                <ListBox.Style>
                    <Style TargetType="ListBox" BasedOn="{StaticResource SoftListBox}">
                        <Style.Triggers>
                            <Trigger Property="HasItems" Value="False">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.Style>
                <ListBox.ContextMenu>
                    <ContextMenu Style="{StaticResource SoftContextMenu}">
                        <MenuItem Style="{StaticResource SoftMenuItem}" Header="_Preview" InputGestureText="Ctrl+P" Click="OnPreview" />
                        <MenuItem Style="{StaticResource SoftMenuItem}" Header="_Open file" InputGestureText="Enter" Click="OnOpenFile" />
                        <MenuItem Style="{StaticResource SoftMenuItem}" Header="Show in _Explorer" Click="OnReveal" />
                        <MenuItem Style="{StaticResource SoftMenuItem}" Header="_Copy path" InputGestureText="Ctrl+C" Click="OnCopyPath" />
                    </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:ResultRow}">
                        <Border MinHeight="54" Padding="9,10,9,10" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Line}">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource ControlSurface}" CornerRadius="8" Width="38" Height="38"
                                        Margin="0,0,13,0" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding FormatIcon}" FontSize="10" FontWeight="SemiBold"
                                               ToolTip="{Binding FormatLabel}" AutomationProperties.Name="{Binding FormatLabel}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Name}" local:HighlightText.Value="{Binding Name}"
                                               local:HighlightText.Terms="{Binding Hit.Highlights}" />
                                    <TextBlock Text="{Binding FormatLabel}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FormatLabel}" FontSize="11" Foreground="{DynamicResource Secondary}" />
                                    <TextBlock Text="{Binding PathText}" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathText}"
                                               Foreground="{DynamicResource Secondary}" Margin="0,3,0,0"
                                               Visibility="{Binding DataContext.ShowPath, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}" />
                                    <TextBlock Text="{Binding ModifiedText}" FontSize="12" Foreground="{DynamicResource Secondary}"
                                               Margin="0,3,0,0" TextWrapping="Wrap"
                                               Visibility="{Binding DataContext.ShowModified, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource VisibleWhenTrue}}" />
                                    <TextBlock Text="{Binding MatchLocation}" Foreground="{DynamicResource Secondary}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Margin" Value="0,3,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MatchLocation}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.ShowLocation, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Foreground="{DynamicResource Secondary}" TextWrapping="Wrap"
                                               local:HighlightText.Value="{Binding Hit.Snippet}" local:HighlightText.Terms="{Binding Hit.Highlights}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Setter Property="Margin" Value="0,4,0,0" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Hit.Snippet}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding DataContext.ShowExcerpt, RelativeSource={RelativeSource AncestorType=Window}}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Source unavailable" Foreground="{DynamicResource Secondary}" FontSize="12"
                                               Visibility="{Binding Unavailable, Converter={StaticResource VisibleWhenTrue}}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Border Grid.Row="4" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Line}" Margin="0,4,0,0" Padding="0,7,0,0">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="Index settings" Click="OnSettings" MinWidth="121"
                        Margin="10,0,0,0" Style="{StaticResource SoftButton}" AutomationProperties.AutomationId="IndexSettingsButton" />
                <TextBlock Text="{Binding IndexMessage}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="12" Foreground="{DynamicResource Secondary}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
