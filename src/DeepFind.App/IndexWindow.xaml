<Window x:Class="DeepFind.App.IndexWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Index settings" Width="690" Height="620" MinWidth="440" MinHeight="405"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI" FontSize="14"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Ink}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,5" />
        </Style>
        <Style TargetType="Label"><Setter Property="Padding" Value="0,7,0,4" /></Style>
        <Style TargetType="TextBox"><Setter Property="Padding" Value="5,3" /></Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TabControl x:Name="Tabs">
            <TabItem Header="Folders">
                <DockPanel Margin="12">
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                        <Button Content="Add folder…" Click="OnAddFolder" />
                        <Button Content="Remove folder" Click="OnRemoveFolder" />
                    </WrapPanel>
                    <ListBox x:Name="FolderList" AutomationProperties.Name="Indexed folders"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </DockPanel>
            </TabItem>
            <TabItem Header="Status">
                <DockPanel Margin="12">
                    <TextBlock DockPanel.Dock="Top" Text="{Binding IndexMessage}" Margin="0,0,0,8" />
                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,7">
                        <Button Content="Update now" Click="OnUpdate" />
                        <Button x:Name="PauseButton" Content="Pause" Click="OnPause" />
                        <Button Content="Retry selected file" Click="OnRetry" />
                        <Button Content="Rebuild index" Click="OnRebuild" />
                        <Button Content="Clear index" Click="OnClear" />
                    </WrapPanel>
                    <ListBox x:Name="IssuesList" ItemsSource="{Binding Issues}" AutomationProperties.Name="Index notices"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="3,3,3,7">
                                    <TextBlock Text="{Binding File.Path}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Issue}" TextWrapping="Wrap" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </TabItem>
            <TabItem Header="Preferences">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12">
                        <Label Content="Maximum file size (MB)" Target="{Binding ElementName=MaxSize}" />
                        <TextBox x:Name="MaxSize" MaxLength="5" />
                        <CheckBox x:Name="IncludeOther" Content="Include other file types in name and path results" Margin="0,10,0,0" />
                        <Label Content="Exclude paths or names (one pattern per line, * and ? supported)" Target="{Binding ElementName=Exclusions}" />
                        <TextBox x:Name="Exclusions" AcceptsReturn="True" Height="70" VerticalScrollBarVisibility="Auto" />
                        <Label Content="Check local folders every (hours)" Target="{Binding ElementName=LocalHours}" />
                        <TextBox x:Name="LocalHours" MaxLength="3" />
                        <Label Content="Check network folders every (hours)" Target="{Binding ElementName=NetworkHours}" />
                        <TextBox x:Name="NetworkHours" MaxLength="3" />
                        <Label Content="Index storage parent folder (takes effect on restart)" Target="{Binding ElementName=IndexLocation}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseIndex" Margin="6,0,0,0" />
                            <TextBox x:Name="IndexLocation" />
                        </DockPanel>
                        <TextBlock x:Name="StorageNote" TextWrapping="Wrap" Margin="0,7,0,0" />
                        <Label Content="Appearance" Target="{Binding ElementName=ThemeChoice}" />
                        <ComboBox x:Name="ThemeChoice" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
        <TextBlock x:Name="Feedback" Grid.Row="1" TextWrapping="Wrap" Margin="0,8,0,0"
                   AutomationProperties.LiveSetting="Polite" />
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button x:Name="ApplyButton" Content="Apply changes" Click="OnApply" />
            <Button Content="Close" IsCancel="True" Margin="0,0,0,5" />
        </StackPanel>
    </Grid>
</Window>
